{
  "compilerOptions": {
    "types": ["mocha"],
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "lib": ["es2022"],
    "module": "es2022",
    "target": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true
  },
  "include": ["tests/**/*"]
}
