# three.ws inference node operator client (NVIDIA GPU image).
#
# Same client as the CPU Dockerfile, layered on the NVIDIA CUDA runtime so the
# ONNX graph executes on the GPU through onnxruntime-node's CUDA provider.
#
# Host requirement: NVIDIA driver + nvidia-container-toolkit. Verify the host
# with `nvidia-smi`, then:
#
#   docker build -f Dockerfile.gpu -t three-ws/node-operator:gpu .
#   docker run --rm --gpus all \
#     -e NODE_SECRET_KEY=... -e NODE_WORKER_SECRET=... \
#     -e BASE_URL=https://three.ws \
#     -v node-model-cache:/app/.model-cache \
#     three-ws/node-operator:gpu
#
# onnxruntime-node detects the CUDA libraries from this base image and picks
# the CUDA execution provider automatically (engine.js lists cuda before cpu).

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV NODE_ENV=production \
    MODEL_CACHE_DIR=/app/.model-cache \
    DEBIAN_FRONTEND=noninteractive \
    ONNXRUNTIME_CUDA=1

# Node.js 24 from the official binary tarball; the runtime base image has no
# Node of its own.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates xz-utils && \
    curl -fsSL https://nodejs.org/dist/v24.14.0/node-v24.14.0-linux-x64.tar.xz -o /tmp/node.tar.xz && \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && \
    rm /tmp/node.tar.xz && \
    apt-get purge -y xz-utils && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY src ./src
COPY README.md ./

RUN useradd --system --uid 10001 --home /app node && \
    mkdir -p /app/.model-cache && \
    chown -R node:node /app
USER node

CMD ["node", "src/cli.js", "run"]
