# Bubblewrap output — regenerated on every build, do not commit.
build/

# Release keystore. NEVER commit. Back it up (file + password) to the owner's
# password manager; losing it means the app can never be updated again.
*.keystore
*.jks

# Local Bubblewrap state.
twa-manifest.json.bak
.bubblewrap/

# Captured screenshots that haven't been triaged yet.
publish/media/_drafts/

# Publisher Portal API key, if ever written to disk.
publish/.dapp-store-api-key
# Local Node deps pulled in by scripts/publish.sh (dapp-store-cli).
node_modules/
package-lock.json
