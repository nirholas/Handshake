<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0 on purpose: refreshes come from WorkManager
     (GlanceRefreshWorker), which is battery-aware and coalesced, not from the
     AppWidget alarm. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="320dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_widget_wide"
    android:previewLayout="@layout/glance_widget_wide"
    android:description="@string/glance_widget_description"
    android:widgetCategory="home_screen" />
