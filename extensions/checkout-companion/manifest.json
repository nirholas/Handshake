{
	"manifest_version": 3,
	"name": "three.ws Checkout Companion",
	"short_name": "Checkout Companion",
	"version": "1.0.0",
	"description": "Your agent reads the checkout before you pay: what it really costs, whether it repeats, and what the fine print commits you to.",
	"homepage_url": "https://three.ws/companion",

	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},

	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		},
		"default_title": "three.ws Checkout Companion"
	},

	"background": {
		"service_worker": "background.js",
		"type": "module"
	},

	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["content.js"],
			"css": ["panel.css"],
			"run_at": "document_idle",
			"all_frames": false
		}
	],

	"web_accessible_resources": [
		{
			"resources": ["extract.js", "panel.js", "avatar.svg"],
			"matches": ["http://*/*", "https://*/*"]
		}
	],

	"permissions": ["storage", "alarms"],

	"host_permissions": ["https://three.ws/*"],

	"options_page": "options.html",

	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},

	"minimum_chrome_version": "109"
}
