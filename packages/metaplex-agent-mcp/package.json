{
	"name": "@three-ws/metaplex-agent-mcp",
	"version": "0.1.2",
	"mcpName": "io.github.nirholas/metaplex-agent",
	"description": "Deploy AI agents on-chain into the Metaplex Agent Registry on Solana, exactly the way the three.ws Genesis 333 shipped: one atomic transaction mints a Metaplex Core asset (data: URI metadata, verified creator, royalties, immutable metadata) and registers its EIP-8004 agent identity. Agents sign with their own key; people sign with Phantom, Solflare, or any Solana wallet via the prepare/send flow. Every Core plugin and every metadata field is customizable.",
	"type": "module",
	"author": "nirholas <support@three.ws>",
	"license": "SEE LICENSE IN LICENSE",
	"homepage": "https://three.ws",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nirholas/three.ws.git",
		"directory": "packages/metaplex-agent-mcp"
	},
	"bugs": {
		"url": "https://github.com/nirholas/three.ws/issues"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"three.ws",
		"metaplex",
		"agent-registry",
		"mpl-core",
		"solana",
		"onchain-agent",
		"erc-8004",
		"eip-8004",
		"x402",
		"ai-agent",
		"nft"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"server.json",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"metaplex-agent-mcp": "src/index.js"
	},
	"main": "./src/index.js",
	"exports": {
		".": "./src/index.js",
		"./lib": "./src/lib/index.js",
		"./lib/registration": "./src/lib/registration.js",
		"./lib/mint": "./src/lib/mint.js"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "node src/index.js",
		"test": "node --test \"test/**/*.test.mjs\"",
		"inspect": "npx -y @modelcontextprotocol/inspector node src/index.js"
	},
	"dependencies": {
		"@metaplex-foundation/mpl-agent-registry": "^0.2.6",
		"@metaplex-foundation/mpl-core": "^1.10.0",
		"@metaplex-foundation/umi": "^1.5.1",
		"@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"bs58": "^6.0.0",
		"zod": "^3.23.8"
	}
}
