		"ansi",
		"terminal",
		"avatar",
		"three.js",
		"skinning",
		"og-image"
	],
	"author": "three.ws <support@three.ws> (https://three.ws)",
	"license": "Apache-2.0",
	"homepage": "https://three.ws/tty",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nirholas/three.ws.git",
		"directory": "packages/render"
	},
	"bugs": {
		"url": "https://github.com/nirholas/three.ws/issues"
	},
	"type": "module",
	"main": "./src/index.js",
	"module": "./src/index.js",
	"exports": {
		".": "./src/index.js",
