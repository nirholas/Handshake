{
  "name": "@three-ws/motion",
  "version": "0.1.0",
  "description": "Text and structure to full-body 3D animation. A Motion Score in, a three.js AnimationClip out: forward and inverse kinematics, balance, ground contact and secondary motion in plain JavaScript, with no mocap data, no model weights and no renderer.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "three-ws-motion": "./bin/motion.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./rig": {
      "import": "./src/rig/index.js",
      "default": "./src/rig/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "3d",
    "animation",
    "motion",
    "procedural-animation",
    "inverse-kinematics",
    "ik",
    "skeleton",
    "rig",
    "humanoid",
    "avatar",
    "text-to-motion",
    "animationclip",
    "threejs",
    "gltf",
    "glb",
    "three.ws"
  ],
  "author": "nirholas <support@three.ws>",
  "license": "Apache-2.0",
  "homepage": "https://three.ws/motion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/three.ws.git",
    "directory": "packages/motion"
  },
  "bugs": {
    "url": "https://github.com/nirholas/three.ws/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
