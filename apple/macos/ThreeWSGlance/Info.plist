<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>three.ws Glance</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!--
		A menu bar app. No Dock icon and no menu bar of its own: the widget is
		the product and this app feeds it. The link window still opens at launch
		and from the menu bar item, so nothing is unreachable.
	-->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>three.ws</string>
	<!--
		The scheme /api/glance/token builds its links.apple URL with. The token
		arrives as threews://glance/link?token=glw_... and is claimed natively in
		GlanceLinkModel, so it never reaches a web view or the pasteboard.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ws.three.glance.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>threews</string>
			</array>
		</dict>
	</array>
	<key>GlanceOrigin</key>
	<string>$(GLANCE_ORIGIN)</string>
	<key>GlanceAppGroup</key>
	<string>$(GLANCE_APP_GROUP)</string>
	<key>GlanceKeychainGroup</key>
	<string>$(GLANCE_KEYCHAIN_GROUP)</string>
</dict>
</plist>
