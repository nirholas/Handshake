<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Universal links. Every https://three.ws link the app can handle opens in
		the app instead of Safari, which is what makes a shared /viewer, /irl/s/
		or /avatars/ link land on an installed app. Paired with
		public/.well-known/apple-app-site-association, which Apple's CDN fetches
		over TLS with no redirects; if that file 404s or is served with the wrong
		content type, links silently keep opening in Safari and nothing errors.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:three.ws</string>
		<string>applinks:www.three.ws</string>
		<!-- Password AutoFill for the three.ws login form inside the WebView. -->
		<string>webcredentials:three.ws</string>
	</array>

	<!--
		APNs. Xcode rewrites this to "production" on an App Store / TestFlight
		archive; "development" is what a device build off a personal team needs.
	-->
	<key>aps-environment</key>
	<string>development</string>

	<!--
		CarPlay, voice-based conversational category (iOS 26.4 and later). This
		is what puts three.ws Drive on the car screen. Apple grants it per app
		on request (https://developer.apple.com/carplay/), and a build signed
		without the grant simply never sees a CarPlay scene: the phone app is
		unaffected either way, so this key is safe to carry before approval
		lands. See ios/docs/CARPLAY.md for the request and the review notes.
	-->
	<key>com.apple.developer.carplay-voice-based-conversation</key>
	<true/>
</dict>
</plist>
